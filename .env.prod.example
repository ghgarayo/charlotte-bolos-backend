# Modelo do .env.prod. Copie, preencha e NUNCA versione o arquivo preenchido.
#
#   docker compose --env-file .env.prod up -d
#
# No perfil prod as credenciais nao tem default: se qualquer uma faltar, a
# aplicacao falha no start em vez de usar valores de desenvolvimento.

# Opcional: prod ja e o perfil padrao. Explicito aqui por clareza.
SPRING_PROFILES_ACTIVE=prod

DB_HOST=
DB_PORT=5432
DB_NAME=charlotte_bolos
DB_USER=
DB_PASSWORD=

APP_PORT=8080

# Origens autorizadas a chamar a API pelo navegador, separadas por virgula.
# Ex.: https://charlottebolos.com.br,https://www.charlottebolos.com.br
CORS_ALLOWED_ORIGINS=

# Administrador inicial, criado pela migracao V2 no primeiro start.
# ATENCAO: ADMIN_PASSWORD_HASH e o hash BCrypt, nao a senha em texto puro.
# Como gerar o hash: ver docs/00-progresso.md.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Segredo de assinatura dos tokens JWT. MINIMO 32 CARACTERES.
# Gere um aleatorio, por exemplo: openssl rand -base64 48
JWT_SECRET=
