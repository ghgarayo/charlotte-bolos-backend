# Modelo do .env.prod. Copie, preencha e NUNCA versione o arquivo preenchido.
#
#   docker compose --env-file .env.prod up -d
#
# No perfil prod as credenciais nao tem default: se qualquer uma faltar, a
# aplicacao falha no start em vez de usar valores de desenvolvimento.

# Opcional: prod ja e o perfil padrao. Explicito aqui por clareza.
SPRING_PROFILES_ACTIVE=prod

DB_HOST=
DB_PORT=5432
DB_NAME=charlotte_bolos
DB_USER=
DB_PASSWORD=

APP_PORT=8080
