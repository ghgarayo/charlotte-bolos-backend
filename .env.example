# Copie para .env e ajuste se precisar.
# O docker compose le esse arquivo automaticamente. ATENCAO: quem le o .env e o
# Compose, nao o Spring Boot - rodando `mvn spring-boot:run` direto no host, este
# arquivo e ignorado e valem os defaults do application.yml.

# Perfil do Spring. O padrao da aplicacao e `prod`; dev precisa ser declarado.
# Ativa show-sql e baseline-on-migrate (ver application-dev.yml).
SPRING_PROFILES_ACTIVE=dev

DB_NAME=charlotte_bolos
DB_USER=postgres
DB_PASSWORD=postgres

# Portas expostas no host (mude se ja houver algo ocupando)
DB_PORT=5432
APP_PORT=8080
DEBUG_PORT=5005
